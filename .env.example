# Vision model endpoint (OpenAI-compatible chat completions).
# Default: Meta's Llama API.
LLM_API_KEY=paste_your_llama_api_key_here

# Optional overrides:
# LLM_BASE_URL=https://api.meta.ai/v1/chat/completions
# LLM_MODEL=muse-spark-1.3
# PORT=8001

# Gemma fallback (Ollama Cloud) for the model dropdown.
# GEMMA_BASE_URL=https://ollama.com/v1/chat/completions
# GEMMA_MODEL=gemma4:31b
# GEMMA_API_KEY=paste_your_ollama_key_here

# Gemini middle ground (Google AI Studio free tier) for the dropdown.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=paste_your_gemini_key_here

# Ring fixed camera via go2rtc gateway (used when Ask posts {ring: true}).
# GO2RTC_URL=http://localhost:1984
# RING_SRC=clockcam

# MongoDB (Atlas free M0 or local): per-read records for the Statistics tab.
# Without it, reads still work but /api/stats reports "database not configured".
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxx.mongodb.net/ai-clock
